# Vorlage der Agent-Umgebung. Massgeblich ist das Zod-Schema in src/config.ts —
# wer dort etwas ergaenzt, ergaenzt es hier mit.
PORT=8080
NODE_ENV=production
RUN_MODE=all

# Nur fuer den lokalen E2E-Rauchtest. In Produktion verboten (validate.sh).
LOCAL_SMOKE=false
LOCAL_FAKE_BRAIN_ANSWER=

# Eigene Datenbank des Agenten (Zustand, Zustellung, Auto-Send-Buchfuehrung).
DATABASE_URL=postgresql://support_ai:CHANGE_ME@postgres:5432/support_ai
# Chatwoots Datenbank, ausschliesslich lesend (Delivery-Idempotenz, Lern-Miner).
CHATWOOT_DATABASE_URL=postgresql://chatwoot_ro:CHANGE_ME@postgres:5432/chatwoot
REDIS_URL=redis://:CHANGE_ME@redis:6379/1
CHATWOOT_BASE_URL=http://rails:3000

# Ein Eintrag je Mandant: key, accountId, webhookSecret, apiToken, handoffAssigneeId.
TENANTS_JSON='[]'

WEBHOOK_REPLAY_WINDOW_SECONDS=300
DELIVERY_RETENTION_SECONDS=86400
MAX_BODY_BYTES=262144

# Gehirn-API der Website: der einzige Weg, auf dem eine Antwort entsteht.
# Origin ohne Pfad, HTTPS erzwungen. Signiert wird `${timestamp}.${rawBody}`.
SUPPORT_ANSWER_URL=https://www.myinvest-pro.de
SUPPORT_ANSWER_SECRET=
SUPPORT_ANSWER_TIMEOUT_MS=25000

# Kill-Switch fuer automatisch gesendete Antworten. Standard AUS: Auto-Send
# wird bewusst eingeschaltet, nie versehentlich durch ein fehlendes Env geerbt.
AUTO_SEND_ENABLED=false
AUTO_SEND_MAX_PER_CONVERSATION=3
AUTO_SEND_MAX_PER_CONTACT_PER_HOUR=10
AUTO_SEND_FEEDBACK_INTERVAL_SECONDS=600

# Komma-Liste der WhatsApp-Inbox-IDs (steuert die Formatvorgabe des Kanals).
WHATSAPP_INBOX_IDS=
