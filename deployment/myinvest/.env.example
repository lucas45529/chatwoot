# Generated safely by scripts/setup-env.sh. Never commit .env.
CADDY_SITE_ADDRESS=support.myinvest-pro.de
CADDY_SITE_SCHEME=https
INGRESS_MODE=direct
ACME_EMAIL=lucas.siebeking@myinvest24.de
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
FRONTEND_URL=https://support.myinvest-pro.de
FORCE_SSL=true
ENABLE_ACCOUNT_SIGNUP=false
SAFE_FETCH_ALLOW_PRIVATE_NETWORK=false
DISABLE_TELEMETRY=true
ENABLE_PUSH_RELAY_SERVER=false
ENABLE_RACK_ATTACK=true
ENABLE_RACK_ATTACK_WIDGET_API=true
RACK_ATTACK_LIMIT=300
VIPS_BLOCK_UNTRUSTED=1
DEFAULT_LOCALE=de
TZ=Europe/Berlin
LOCAL_SMOKE=false
LOCAL_FAKE_BRAIN_ANSWER=
IMPORT_ID_HMAC_KEY=__GENERATE_IMPORT_ID_HMAC_KEY__

SECRET_KEY_BASE=__GENERATE__
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=__GENERATE__
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=__GENERATE__
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=__GENERATE__

POSTGRES_HOST=postgres
POSTGRES_ADMIN_USER=chatwoot_admin
POSTGRES_ADMIN_PASSWORD=__GENERATE__
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=chatwoot
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_PORT=5432
POSTGRES_STATEMENT_TIMEOUT=14s
RAILS_MAX_THREADS=5
SIDEKIQ_CONCURRENCY=10

REDIS_PASSWORD=__GENERATE__
REDIS_URL=__GENERATE_REDIS_URL__

CLAUDE_AGENT_DATABASE=claude_agent
CLAUDE_AGENT_DATABASE_USER=claude_agent
CLAUDE_AGENT_DATABASE_PASSWORD=__GENERATE__
CLAUDE_AGENT_DATABASE_URL=__GENERATE_CLAUDE_DATABASE_URL__
AGENT_LEARNING_DATABASE_USER=agent_learning_ro
AGENT_LEARNING_DATABASE_PASSWORD=__GENERATE_AGENT_LEARNING_DATABASE_PASSWORD__
AGENT_LEARNING_CHATWOOT_DATABASE_URL=__GENERATE_CHATWOOT_READONLY_DATABASE_URL__
CLAUDE_AGENT_REDIS_URL=__GENERATE_CLAUDE_REDIS_URL__
TENANTS_JSON='[]'
WEBHOOK_REPLAY_WINDOW_SECONDS=300
DELIVERY_RETENTION_SECONDS=86400
MAX_BODY_BYTES=262144
# Gehirn-API der Website: einziger Antwortweg des Agenten.
SUPPORT_ANSWER_URL=https://www.myinvest-pro.de
SUPPORT_ANSWER_SECRET=
# Unabhaengiger HMAC-Schluessel fuer Kontakt-/Fragepseudonyme.
PSEUDONYMIZATION_KEY=
SUPPORT_ANSWER_TIMEOUT_MS=65000
# Kill-Switch fuer automatisch gesendete Antworten. Standard AUS.
AUTO_SEND_ENABLED=false
AUTO_SEND_MAX_PER_CONVERSATION=3
AUTO_SEND_MAX_PER_CONTACT_PER_HOUR=10
AUTO_SEND_FEEDBACK_INTERVAL_SECONDS=600
# Komma-Liste der WhatsApp-Inbox-IDs (Formatvorgabe fuer den Kanal).
WHATSAPP_INBOX_IDS=

ADMIN_NAME="Lucas Siebeking"
ADMIN_EMAIL=lucas.siebeking@myinvest24.de
ADMIN_PASSWORD=__GENERATE_ADMIN_PASSWORD__
MYINVEST_ACCOUNT_NAME="MyInvest Pro"
ACADEMY_NEW_ACCOUNT_NAME="Academy Neu"
ACADEMY_LEGACY_ACCOUNT_NAME="Academy Alt"
MYINVEST_WEBSITE_URL=https://www.myinvest-pro.de
ACADEMY_NEW_WEBSITE_URL=https://www.myinvest-pro.de
ACADEMY_LEGACY_WEBSITE_URL=https://www.myinvest24.de
MYINVEST_REBOOKING_WEBHOOK_URL=https://www.myinvest-pro.de/api/webhooks/chatwoot

MAILER_SENDER_EMAIL="MyInvest Support <support@myinvest24.de>"
SMTP_DOMAIN=myinvest24.de
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_OPENSSL_VERIFY_MODE=peer

ACTIVE_STORAGE_SERVICE=s3_compatible
MINIO_ROOT_USER=__GENERATE_MINIO_ROOT_USER__
MINIO_ROOT_PASSWORD=__GENERATE_MINIO_ROOT_PASSWORD__
STORAGE_BUCKET_NAME=
STORAGE_ACCESS_KEY_ID=__GENERATE_STORAGE_ACCESS_KEY_ID__
STORAGE_SECRET_ACCESS_KEY=__GENERATE_STORAGE_SECRET_ACCESS_KEY__
STORAGE_REGION=nbg1
STORAGE_ENDPOINT=
STORAGE_FORCE_PATH_STYLE=false
STORAGE_LOCAL_MINIO=true
DIRECT_UPLOADS_ENABLED=false
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=error
LOGRAGE_ENABLED=true
INSTALLATION_NAME="MyInvest Support"
BRAND_NAME="MyInvest Support"

BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_GPG_RECIPIENT=
BACKUP_GPG_SIGNING_KEY=
BACKUP_OFFSITE_REMOTE=

# WhatsApp Cloud cutover for legacy_academy.
# The wrapper requires CUTOVER_CONFIRMATION=cutover-whatsapp:legacy_academy:<phone>.
CUTOVER_CONFIRMATION=
