WHATSAPP_BUSINESS_PORTFOLIO_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_CHANNEL_ACCOUNT_ID=

# Google OAuth for native Google Workspace email channels.
# Optional, but if either is set both must be set. Each semantic tenant must use a
# dedicated shared mailbox; personal mailbox ingestion is forbidden.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Read-only native Email, Instagram DM, and WhatsApp readiness preflight.
# Credential fields in this JSON name other variables in this file; they never
# contain credential values directly. See README.md for the manifest contract.
CHANNEL_READINESS_CONFIG_JSON='[]'
HUBSPOT_CUTOVER_CONFIRMED=false
CHANNEL_READINESS_INSTAGRAM_ACCESS_TOKEN=
CHANNEL_READINESS_WHATSAPP_ACCESS_TOKEN=
CHANNEL_READINESS_WHATSAPP_APP_SECRET=
